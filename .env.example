GLOW_AI_ENABLED=false

# Keep disabled until migration, SMTP, server authorization and account isolation are verified.
VITE_BETA_AUTH_ENABLED=false
VITE_CLOUD_DATA_ENABLED=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
