# Copy to .env.local and fill in values from Supabase → Project Settings → API Keys / Connect

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer legacy "anon" JWT if publishable key fails with older tooling; publishable also works with supabase-js >= 2.49
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Used only by `npm run db:migrate:supabase` (never prefix with VITE_)
SUPABASE_DB_PASSWORD=your_db_password
# Optional full connection string from Connect → ORM / Direct
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
