{
  "rewrites": [
    {
      "source": "/api/smartapi/:path*",
      "destination": "https://api.smartapi.shop/v1/:path*"
    },
    {
      "source": "/api/mcsix/:path*",
      "destination": "https://api.mcsix.space/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
