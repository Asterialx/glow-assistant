{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Glow Assistant default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://co.agentrouter.org/**" },
        { "url": "https://api.smartapi.shop/**" },
        { "url": "https://huggingface.co/**" },
        { "url": "https://*.huggingface.co/**" },
        { "url": "https://hf.co/**" },
        { "url": "https://cdn.jsdelivr.net/**" },
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1:*/**" }
      ]
    }
  ]
}
